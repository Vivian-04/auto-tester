# Port the FastAPI service listens on (Coolify sets this too).
PORT=8000

# --- Supabase (leave empty to run in local dev mode with an in-memory store) ---
# Project Settings -> Data API / API Keys
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: verify dashboard logins locally instead of calling Supabase
# (Project Settings -> Auth -> JWT secret)
SUPABASE_JWT_SECRET=

# Comma-separated origins allowed to call the API directly (the Next.js
# frontend normally proxies through /api/backend, so this can stay as-is).
AUTOTESTER_CORS_ORIGINS=http://localhost:3000

# Evidence (failure screenshots) retention: files are kept under ./evidence
# in dev mode; in Supabase mode they live in the private "evidence" bucket.
EVIDENCE_DIR=evidence

